OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- AI Gateway Configuration (Optional) ---
# Cloudflare AI Gateway:
# AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/openai
#
# Portkey AI Gateway:
# AI_GATEWAY_URL=https://api.portkey.ai/v1
# PORTKEY_API_KEY=your_portkey_api_key
#
# --- LiteLLM Proxy Configuration ---
# LITELLM_PROXY_URL=http://localhost:4000/v1
# LITELLM_API_KEY=your_litellm_master_key

# --- Nginx Edge Reverse Proxy (Optional) ---
# NGINX_PROXY_URL=http://localhost:8080/v1
